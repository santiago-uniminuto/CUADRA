{% extends "base.html" %}

{% block title %}{% if object %}Edit site{% else %}New site{% endif %} — CUADRA{% endblock %}

{% block content %}
<h4 class="mb-4">{% if object %}Edit site{% else %}New site{% endif %}</h4>

<form method="post" class="col-md-6">
  {% csrf_token %}
  {% if form.non_field_errors %}
    <div class="alert alert-danger">
      {% for error in form.non_field_errors %}{{ error }}{% endfor %}
    </div>
  {% endif %}
  <div class="mb-3">
    <label for="{{ form.nombre.id_for_label }}" class="form-label">Name</label>
    {{ form.nombre.errors }}
    <input type="text" name="{{ form.nombre.html_name }}"
           value="{{ form.nombre.value|default_if_none:'' }}"
           class="form-control" id="{{ form.nombre.id_for_label }}" required>
  </div>
  <div class="mb-3">
    <label for="{{ form.direccion.id_for_label }}" class="form-label">Address</label>
    {{ form.direccion.errors }}
    <input type="text" name="{{ form.direccion.html_name }}"
           value="{{ form.direccion.value|default_if_none:'' }}"
           class="form-control" id="{{ form.direccion.id_for_label }}" required>
  </div>
  <button type="submit" class="btn btn-primary">Save</button>
  <a href="{% url 'usuarios:sede_list' %}" class="btn btn-link">Cancel</a>
</form>
{% endblock %}

{% extends "base.html" %}

{% block title %}Sites — CUADRA{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">Sites</h1>
  <a href="{% url 'usuarios:sede_create' %}" class="btn btn-primary btn-sm">+ New site</a>
</div>

{% if sedes %}
<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr><th>Name</th><th>Address</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
      {% for sede in sedes %}
      <tr class="{% if not sede.activo %}text-muted{% endif %}">
        <td>{{ sede.nombre }}</td>
        <td>{{ sede.direccion }}</td>
        <td>{% if sede.activo %}<span class="badge text-bg-success">Active</span>{% else %}<span class="badge text-bg-secondary">Inactive</span>{% endif %}</td>
        <td class="text-end text-nowrap">
          <a href="{% url 'usuarios:sede_edit' sede.pk %}" class="btn btn-outline-secondary btn-sm">Edit</a>
          {% if sede.activo %}
          <a href="{% url 'usuarios:sede_toggle' sede.pk %}" class="btn btn-outline-danger btn-sm">DEACTIVATE</a>
          {% else %}
          <a href="{% url 'usuarios:sede_toggle' sede.pk %}" class="btn btn-outline-success btn-sm">REACTIVATE</a>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<p class="text-muted">No sites registered yet.</p>
{% endif %}
{% endblock %}

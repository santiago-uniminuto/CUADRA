{% extends "base.html" %}
{% block title %}{{ title }} — CUADRA{% endblock %}
{% block content %}
  <h1 class="h3 mb-3">{{ title }}</h1>
  <form method="post" novalidate style="max-width: 420px;">
    {% csrf_token %}
    <div class="mb-3">
      <label class="form-label">Name</label>
      {{ form.nombre }}
      {% for e in form.nombre.errors %}<div class="text-danger small">{{ e }}</div>{% endfor %}
    </div>
    <div class="mb-3">
      <label class="form-label">Contact</label>
      {{ form.contacto }}
      {% for e in form.contacto.errors %}<div class="text-danger small">{{ e }}</div>{% endfor %}
    </div>
    <button type="submit" class="btn btn-success">SAVE</button>
    <a href="{% url 'catalogo:proveedor_list' %}" class="btn btn-secondary">CANCEL</a>
  </form>
{% endblock %}

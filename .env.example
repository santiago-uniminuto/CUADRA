# Copia este archivo como ".env" y ajusta los valores. NUNCA subas ".env" a Git.
# Obligatoria. En el servidor genera una propia (50+ caracteres aleatorios), por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# En el despliegue en red local agrega la IP del computador servidor, ej: localhost,127.0.0.1,192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=cuadra_db
DB_USER=cuadra_user
DB_PASSWORD=1234
DB_HOST=127.0.0.1
DB_PORT=3306

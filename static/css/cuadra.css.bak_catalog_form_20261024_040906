.cuadra-catalog-page .table tbody td{padding:.85rem;vertical-align:middle;border-color:#e9eee9}
.cuadra-catalog-page .table tbody tr:hover{background:rgba(212,175,103,.09)}
.cuadra-catalog-page .btn{border-radius:.6rem;font-weight:650}
.cuadra-catalog-page .btn-success,.cuadra-catalog-page .btn-primary{background:#0e3b2f;border-color:#0e3b2f;color:#fff}
.cuadra-catalog-page .btn-success:hover,.cuadra-catalog-page .btn-primary:hover{background:#15523f;border-color:#15523f}
.cuadra-catalog-page .btn-secondary{background:#f1f2ed;color:#244438;border-color:#d7dfd9}
.cuadra-catalog-page .badge.text-bg-success{background:#dff2e5!important;color:#14502f!important}
.cuadra-catalog-page .badge.text-bg-secondary{background:#e9ebe9!important;color:#59645f!important}
.cuadra-catalog-page .alert-warning{background:#fff7e5;border-color:#e9d09a;color:#6b4d16}
@media(max-width:650px){.cuadra-catalog-page>h1,.cuadra-catalog-page>.d-flex:first-child{padding:1.2rem;gap:1rem}.cuadra-catalog-page>.d-flex:first-child{flex-wrap:wrap}.cuadra-catalog-page>.d-flex:first-child .btn{width:100%}.cuadra-catalog-page>form{padding:1rem}}


/* CUADRA — estilos base (paleta de Engineery Solutions). Se carga después de Bootstrap.
   Dos interfaces:  body.layout-admin  = panel de gestión (administrador)
                    body.layout-pos    = punto de venta (mesero y cajero), tema oscuro y táctil
                    body.layout-guest  = pantallas sin sesión (login)                                  */
:root {
  --cuadra-dark: #0F6E56;
  --cuadra-darker: #0a4f3e;
  --cuadra-accent: #1D9E75;
  --cuadra-gray: #5F5E5A;
  --cuadra-mint: #E1F5EE;

  --bs-primary: #0F6E56;
  --bs-primary-rgb: 15, 110, 86;
  --bs-link-color: #0F6E56;
  --bs-link-color-rgb: 15, 110, 86;
  --bs-link-hover-color: #0a4f3e;
  --bs-link-hover-color-rgb: 10, 79, 62;
  --bs-body-bg: #f4f7f6;
  --bs-body-color: #26302d;
  --topbar-h: 56px;
}

body { background: var(--bs-body-bg); }

/* ---------- Botones con la marca ---------- */
.btn-primary {
  --bs-btn-bg: var(--cuadra-dark); --bs-btn-border-color: var(--cuadra-dark);
  --bs-btn-hover-bg: var(--cuadra-darker); --bs-btn-hover-border-color: var(--cuadra-darker);
  --bs-btn-active-bg: var(--cuadra-darker); --bs-btn-active-border-color: var(--cuadra-darker);
  --bs-btn-disabled-bg: var(--cuadra-dark); --bs-btn-disabled-border-color: var(--cuadra-dark);
}
.btn-outline-primary {
  --bs-btn-color: var(--cuadra-dark); --bs-btn-border-color: var(--cuadra-dark);
  --bs-btn-hover-bg: var(--cuadra-dark); --bs-btn-hover-border-color: var(--cuadra-dark);
  --bs-btn-active-bg: var(--cuadra-darker); --bs-btn-active-border-color: var(--cuadra-darker);
}
.btn-success { --bs-btn-bg: var(--cuadra-accent); --bs-btn-border-color: var(--cuadra-accent);
  --bs-btn-hover-bg: var(--cuadra-dark); --bs-btn-hover-border-color: var(--cuadra-dark); }
.text-bg-success { background-color: var(--cuadra-accent) !important; }

.form-control:focus, .form-select:focus {
  border-color: var(--cuadra-accent); box-shadow: 0 0 0 .2rem rgba(29, 158, 117, .2);
}

/* ---------- Estructura común ---------- */
.app-shell { display: flex; min-height: calc(100vh - var(--topbar-h)); }
.layout-guest .app-shell { min-height: 100vh; }
.app-main { flex: 1 1 auto; min-width: 0; padding: 1.5rem; }
.layout-guest .app-main { max-width: 1140px; margin: 0 auto; }

.user-chip { display: flex; align-items: center; gap: .6rem; color: #fff; }
.user-avatar {
  width: 34px; height: 34px; border-radius: 50%; background: var(--cuadra-mint); color: var(--cuadra-dark);
  display: inline-flex; align-items: center; justify-content: center; font-weight: 700;
}
.user-role { font-size: .75rem; color: rgba(255, 255, 255, .7); }

/* =====================================================================
   PANEL DE ADMINISTRACIÓN
   ===================================================================== */
.topbar { height: var(--topbar-h); background: var(--cuadra-dark); box-shadow: 0 1px 4px rgba(0, 0, 0, .18); position: sticky; top: 0; z-index: 1030; }
.topbar-brand { color: #fff; font-weight: 700; letter-spacing: .14em; text-decoration: none; font-size: 1.15rem; }
.topbar-brand:hover { color: #fff; }
.act-as-menu { min-width: 260px; }
/* Ícono de menú propio, en blanco: el de Bootstrap solo se dibuja dentro de un .navbar (usa una variable de ese componente). */
.topbar .navbar-toggler-icon {
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255,255,255,0.95%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2.4' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
}

.sidebar { width: 250px; flex: 0 0 250px; background: #fff; border-right: 1px solid #dfe7e4; }
@media (min-width: 992px) {
  .sidebar { position: sticky; top: var(--topbar-h); height: calc(100vh - var(--topbar-h)); overflow-y: auto; }
}
.sidebar-nav { padding: .75rem 0; display: flex; flex-direction: column; }
.sidebar-group {
  padding: 1rem 1.25rem .35rem; font-size: .7rem; text-transform: uppercase; letter-spacing: .1em;
  color: var(--cuadra-gray); font-weight: 700;
}
.sidebar-link {
  padding: .6rem 1.25rem; color: #33413d; text-decoration: none; border-left: 3px solid transparent; font-weight: 500;
}
.sidebar-link:hover { background: #f1f7f5; color: var(--cuadra-dark); }
.sidebar-link.active { background: var(--cuadra-mint); color: var(--cuadra-dark); border-left-color: var(--cuadra-accent); font-weight: 600; }
.sidebar-foot { margin-top: auto; padding: 1rem 1.25rem; font-size: .75rem; color: #8a9893; }

.layout-admin .app-main { padding: 1.75rem 2rem; max-width: 1400px; }
.layout-admin h1.h3, .layout-admin h1.h4, .layout-admin h4 { color: var(--cuadra-dark); font-weight: 600; }

.table > thead > tr > th {
  background: var(--cuadra-mint); color: var(--cuadra-dark);
  border-bottom: 2px solid var(--cuadra-accent); white-space: nowrap;
}
.card { border: 0; box-shadow: 0 1px 3px rgba(0, 0, 0, .08); }
.card-header { background: transparent; color: var(--cuadra-dark); font-weight: 600; border-bottom: 1px solid #e6edea; }
.table-responsive { border-radius: .5rem; }

/* Dashboard */
.welcome-banner {
  background: linear-gradient(120deg, var(--cuadra-dark), var(--cuadra-accent)); color: #fff;
  border-radius: .9rem; padding: 1.5rem 1.75rem; box-shadow: 0 2px 8px rgba(15, 110, 86, .25);
}
.welcome-banner h1 { color: #fff; font-size: 1.6rem; margin: 0 0 .25rem; }
.welcome-banner p { margin: 0; color: rgba(255, 255, 255, .85); }
.stat-card { display: block; text-decoration: none; color: inherit; border-radius: .8rem; background: #fff; padding: 1.1rem 1.25rem;
  box-shadow: 0 1px 3px rgba(0, 0, 0, .08); border-top: 3px solid var(--cuadra-accent); height: 100%; transition: transform .12s, box-shadow .12s; }
.stat-card:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0, 0, 0, .12); color: inherit; }
.stat-value { font-size: 2.1rem; font-weight: 700; color: var(--cuadra-dark); line-height: 1.1; }
.stat-label { font-size: .85rem; color: var(--cuadra-gray); text-transform: uppercase; letter-spacing: .06em; font-weight: 600; }
.stat-sub { font-size: .8rem; color: #8a9893; }
.activity-item { padding: .6rem 0; border-bottom: 1px solid #edf2f0; font-size: .92rem; }
.activity-item:last-child { border-bottom: 0; }

/* =====================================================================
   PUNTO DE VENTA (mesero y cajero) — oscuro, botones grandes, táctil
   ===================================================================== */
body.layout-pos { --bs-body-bg: #111816; --bs-body-color: #e9f1ee; background: #111816; font-size: 1.05rem; }
.pos-topbar { background: #0b1210; border-bottom: 2px solid var(--cuadra-accent); min-height: 64px; }
.pos-brand { color: #fff; font-weight: 800; letter-spacing: .16em; text-decoration: none; font-size: 1.3rem; }
.pos-brand:hover { color: #fff; }
.pos-site { background: var(--cuadra-dark); color: #fff; border-radius: 2rem; padding: .35rem 1rem; font-weight: 600; }
.pos-clock { font-variant-numeric: tabular-nums; font-size: 1.4rem; font-weight: 600; color: var(--cuadra-mint); }
.layout-pos .app-main { padding: 1.25rem 1.5rem; max-width: 1600px; margin: 0 auto; width: 100%; }
.layout-pos .btn { min-height: 46px; padding: .55rem 1.1rem; font-size: 1.05rem; border-radius: .6rem; }
.layout-pos .form-control, .layout-pos .form-select { min-height: 50px; font-size: 1.05rem; border-radius: .6rem; }
.layout-pos h1.h3, .layout-pos h1.h4 { font-weight: 700; }

.pos-tabs { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1.25rem; }
.pos-tab {
  min-height: 52px; display: inline-flex; align-items: center; padding: 0 1.6rem; border-radius: .7rem; text-decoration: none;
  background: #1c2723; color: #cfe0da; font-weight: 600; border: 1px solid #2a3934;
}
.pos-tab:hover { background: #24332d; color: #fff; }
.pos-tab.active { background: var(--cuadra-accent); color: #07201a; border-color: var(--cuadra-accent); }

/* Teselas de producto */
.pos-tile {
  display: flex; flex-direction: column; height: 100%; border-radius: .9rem; padding: 1rem 1.1rem;
  background: #1a2521; border: 1px solid #2a3934; border-left: 6px solid var(--cuadra-accent);
}
.pos-tile.out { border-left-color: #dc3545; opacity: .6; }
.pos-tile-name { font-size: 1.2rem; font-weight: 700; line-height: 1.2; }
.pos-tile-type { font-size: .85rem; color: #93a8a1; }
.pos-tile-qty { font-size: 2.4rem; font-weight: 800; line-height: 1; color: #fff; }
.pos-tile-qty small { font-size: .8rem; font-weight: 600; color: #93a8a1; text-transform: uppercase; letter-spacing: .06em; }
.pos-tile-price { font-size: 1.05rem; color: var(--cuadra-mint); font-weight: 600; }

.pos-panel { background: #1a2521; border: 1px solid #2a3934; border-radius: 1rem; padding: 1.5rem; }

/* ---------- Pantallas angostas ---------- */
@media (max-width: 991.98px) {
  .layout-admin .app-main { padding: 1.1rem; }
}
@media (max-width: 576px) {
  .app-main { padding: .85rem; }
  .welcome-banner { padding: 1.1rem; }
  .pos-clock { display: none; }
  .table td.text-nowrap { white-space: normal !important; }
}


/* =====================================================================
   CUADRA / BAR & RESTAURANT — Design system v1
   Layered over the existing Bootstrap and POS styles; visual-only.
   ===================================================================== */
:root {
  --cuadra-dark: #0E3B2F;
  --cuadra-darker: #082A23;
  --cuadra-accent: #D4AF67;
  --cuadra-gray: #64736D;
  --cuadra-mint: #E9F1E9;
  --bs-primary: #0E3B2F;
  --bs-primary-rgb: 14,59,47;
  --bs-link-color: #0E3B2F;
  --bs-link-color-rgb: 14,59,47;
  --bs-link-hover-color: #082A23;
  --bs-link-hover-color-rgb: 8,42,35;
  --bs-body-bg: #F3F5F0;
  --topbar-h: 72px;
}
body { background: radial-gradient(ellipse at 90% 0%, #e1e9dc 0%, transparent 45%), #F3F5F0; }
.topbar, .pos-topbar { background: linear-gradient(115deg, #082820, #103B30 65%, #1D4636); border-bottom: 1px solid rgba(212,175,103,.35); box-shadow: 0 12px 35px rgba(5,31,24,.16); }
.topbar { min-height: var(--topbar-h); }
.brand-lockup { display: inline-flex; align-items: center; gap: .65rem; letter-spacing: .11em; line-height: 1; white-space: nowrap; }
.brand-mark { width: 44px; height: 44px; object-fit: contain; filter: drop-shadow(0 2px 6px rgba(212,175,103,.15)); }
.brand-lockup small { display: block; font-size: .52rem; font-weight: 600; letter-spacing: .26em; color: #E3BE78; margin-top: .4rem; }
.topbar-brand:hover, .pos-brand:hover { color: #F5E3BD; }
.sidebar { background: rgba(255,255,255,.79); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border-right: 1px solid rgba(14,59,47,.12); }
.sidebar-link { border-radius: 0 .75rem .75rem 0; margin-right: .65rem; transition: background .15s ease, color .15s ease; }
.sidebar-link.active { background: #E1EDE3; border-left-color: #B68B48; color: #0E3B2F; }
.sidebar-link:hover { background: #E9F0E8; }
.sidebar-foot { color: #52675C; border-top: 1px solid rgba(14,59,47,.1); }
.sidebar-foot span { font-size: .68rem; margin-top: .2rem; }
.layout-admin .card, .layout-admin .stat-card {
  background: rgba(255,255,255,.84); border: 1px solid rgba(255,255,255,.9);
  box-shadow: 0 10px 32px rgba(12,44,33,.07);
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  border-radius: 1rem;
}
.layout-admin .card-header { color: #173D30; }
.layout-admin .stat-card { border-top: 3px solid #C6A15E; }
.layout-admin .stat-value { color: #0E3B2F; }
.welcome-banner { background: linear-gradient(115deg,#0A2D25,#155040 70%,#406347); box-shadow: 0 16px 38px rgba(8,44,35,.2); border: 1px solid rgba(212,175,103,.25); }
.btn-primary { --bs-btn-bg:#0E3B2F; --bs-btn-border-color:#0E3B2F; --bs-btn-hover-bg:#155342; --bs-btn-hover-border-color:#155342; --bs-btn-active-bg:#082A23; --bs-btn-active-border-color:#082A23; --bs-btn-disabled-bg:#0E3B2F; --bs-btn-disabled-border-color:#0E3B2F; }
.btn-outline-primary { --bs-btn-color:#0E3B2F; --bs-btn-border-color:#0E3B2F; --bs-btn-hover-bg:#0E3B2F; --bs-btn-hover-border-color:#0E3B2F; }
.form-control:focus,.form-select:focus { border-color:#B68B48; box-shadow:0 0 0 .2rem rgba(212,175,103,.22); }
.table > thead > tr > th { background: #E8EEE6; color: #173D30; border-bottom: 2px solid #C6A15E; }
.layout-pos { --bs-body-bg:#101A17; --bs-body-color:#F1F2EB; background: radial-gradient(ellipse at 80% -10%, #174C3B 0%, transparent 43%), #101A17 !important; }
.pos-topbar { min-height: 76px; }
.pos-site { background: rgba(212,175,103,.14); border:1px solid rgba(212,175,103,.35); color: #F1D69E; }
.pos-clock { color: #F1D69E; }
.pos-tab { background: rgba(31,54,45,.8); border: 1px solid rgba(212,175,103,.15); color:#E0EAE1; backdrop-filter: blur(12px); }
.pos-tab:hover { background:#294B3D; }
.pos-tab.active { background:#D4AF67; border-color:#D4AF67; color:#1A241B; }
.pos-panel,.pos-tile { background: rgba(29,51,42,.83); border:1px solid rgba(209,223,205,.14); box-shadow:0 10px 26px rgba(0,0,0,.12); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); }
.pos-tile { border-left:5px solid #D4AF67; }
.pos-tile.out { border-left-color:#D96761; }
.pos-tile-price { color:#F1D69E; }
.layout-pos .btn-primary { --bs-btn-bg:#D4AF67; --bs-btn-border-color:#D4AF67; --bs-btn-color:#15251D; --bs-btn-hover-bg:#E6C587; --bs-btn-hover-border-color:#E6C587; --bs-btn-hover-color:#15251D; --bs-btn-active-bg:#B88E4A; --bs-btn-active-border-color:#B88E4A; --bs-btn-active-color:#15251D; }
.layout-guest .app-main { display:flex; align-items:center; justify-content:center; }
.layout-guest .card { border:1px solid rgba(255,255,255,.75); border-radius:1.25rem; background:rgba(255,255,255,.88); box-shadow:0 22px 70px rgba(11,46,34,.12) !important; backdrop-filter:blur(16px); }
.login-identity img { display:block; margin:0 auto .5rem; background:#0B352B; border-radius:1.1rem; padding:.5rem; }
.login-wordmark { font-size:1.65rem; font-weight:850; letter-spacing:.2em; color:#0E3B2F; }
.login-tagline { font-size:.68rem; letter-spacing:.22em; color:#967344; font-weight:700; }
@media(max-width:575.98px) { .brand-mark { width:36px;height:36px; } .brand-lockup small { font-size:.42rem;letter-spacing:.13em; } .pos-topbar { gap:.6rem !important; } }
@media(prefers-reduced-motion:reduce) { .sidebar-link,.stat-card { transition:none !important; } }
@media print { body { background:#fff !important; } .layout-admin .card,.layout-admin .stat-card,.pos-panel { box-shadow:none !important; backdrop-filter:none !important; } }

/* CUADRA brand hotfix 1.1 — header stays compact even with browser cache. */
.topbar .brand-lockup, .pos-topbar .brand-lockup { display:inline-flex !important; align-items:center; gap:.65rem; flex:0 1 auto; min-width:0; line-height:1.1; }
.topbar .brand-lockup .brand-mark, .pos-topbar .brand-lockup .brand-mark { display:block; width:40px !important; height:40px !important; max-width:40px !important; max-height:40px !important; flex:0 0 40px; object-fit:contain; }
.topbar .brand-lockup > span, .pos-topbar .brand-lockup > span { display:flex; flex-direction:column; font-size:1.05rem; letter-spacing:.12em; font-weight:800; }
.topbar .brand-lockup small, .pos-topbar .brand-lockup small { display:block; font-size:.53rem; letter-spacing:.14em; margin-top:.2rem; font-weight:600; }
.topbar { height:auto; min-height:70px; }
.pos-topbar { min-height:74px; }
@media(max-width:575.98px){ .topbar .brand-lockup .brand-mark,.pos-topbar .brand-lockup .brand-mark { width:32px !important; height:32px !important; max-width:32px !important; max-height:32px !important; flex-basis:32px; } .topbar .brand-lockup > span,.pos-topbar .brand-lockup > span {font-size:.88rem;} .topbar .brand-lockup small,.pos-topbar .brand-lockup small {font-size:.43rem;} }

/* CUADRA — Waiter POS: floor tables and order management, visual-only. */
.cuadra-pos-workspace{max-width:1500px;margin:0 auto;padding:.4rem 0 2rem}
.cuadra-workspace-head{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;margin-bottom:1.6rem}
.cuadra-eyebrow{color:#b99457;font-size:.72rem;letter-spacing:.15em;font-weight:800;margin-bottom:.35rem}
.cuadra-workspace-head h1{font-size:clamp(1.6rem,2.5vw,2.35rem);font-weight:800;letter-spacing:-.03em;margin:0 0 .3rem}
.cuadra-workspace-head p{margin:0;opacity:.74}
.cuadra-workspace-count{padding:.6rem 1.2rem;border:1px solid rgba(212,175,103,.45);border-radius:1rem;font-size:1.8rem;font-weight:800;white-space:nowrap}
.cuadra-workspace-count span{font-size:.78rem;font-weight:500;opacity:.75}
.cuadra-table-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:1rem}
.cuadra-table-card{display:flex;flex-direction:column;min-height:250px;padding:1.2rem;border-radius:1.1rem;background:rgba(29,51,42,.82);border:1px solid rgba(230,239,228,.13);box-shadow:0 12px 30px rgba(0,0,0,.12);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:transform .15s,border-color .15s}
.cuadra-table-card:hover{transform:translateY(-2px);border-color:rgba(212,175,103,.55)}
.cuadra-table-card.is-occupied{border-top:3px solid #e2ae5c}
.cuadra-table-card.is-available{border-top:3px solid #45b99b}
.cuadra-table-top{display:flex;justify-content:space-between;align-items:center;gap:.5rem}
.cuadra-table-icon{font-size:1.35rem;color:#d4af67}
.cuadra-table-status{font-size:.73rem;font-weight:700;border-radius:99px;padding:.3rem .55rem;white-space:nowrap}
.cuadra-table-status.is-occupied{background:rgba(226,174,92,.16);color:#f2cd8e}
.cuadra-table-status.is-available{background:rgba(69,185,155,.15);color:#91e1c9}
.cuadra-status-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:currentColor;margin-right:.4rem}
.cuadra-table-number{display:flex;align-items:baseline;gap:.65rem;margin-top:.85rem}
.cuadra-table-number small{font-size:.75rem;letter-spacing:.1em;opacity:.7}
.cuadra-table-number strong{font-size:2.7rem;line-height:1.2;color:#fff}
.cuadra-table-note{font-size:.85rem;color:#c2d3ca;margin:.2rem 0 1.1rem}
.cuadra-table-actions{margin-top:auto;display:grid;gap:.55rem}
.cuadra-table-actions .btn{min-height:43px;font-weight:700;border-radius:.65rem}
.cuadra-service-hint{font-size:.84rem;opacity:.73;margin-top:1.3rem;line-height:1.55}
.cuadra-empty-state{grid-column:1/-1;padding:2rem;border:1px dashed #a9b9b0;border-radius:1rem}
.cuadra-back-link{display:inline-block;margin-bottom:1.2rem;color:#e1bc7a;text-decoration:none;font-weight:700}
.cuadra-back-link:hover{color:#ffe0a7;text-decoration:underline}
.cuadra-order-status{padding:.45rem .9rem;border:1px solid rgba(212,175,103,.5);border-radius:99px;color:#f0cd90;font-weight:700}
.cuadra-order-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(270px,1fr);gap:1.2rem;align-items:start}
.cuadra-service-panel{background:rgba(29,51,42,.82);border:1px solid rgba(230,239,228,.14);border-radius:1.1rem;padding:1.35rem;box-shadow:0 12px 30px rgba(0,0,0,.12);backdrop-filter:blur(12px)}
.cuadra-panel-heading{display:flex;justify-content:space-between;gap:.5rem;align-items:center;margin-bottom:1rem}
.cuadra-panel-heading h2{font-size:1.15rem;font-weight:750;margin:0}
.cuadra-panel-heading span{font-size:.8rem;opacity:.7}
.cuadra-order-table{--bs-table-bg:transparent;--bs-table-color:#f1f2eb;--bs-table-border-color:rgba(255,255,255,.12)}
.cuadra-order-table>thead>tr>th{background:rgba(212,175,103,.1);color:#f1d69e;border-bottom:1px solid rgba(212,175,103,.25);font-size:.82rem}
.cuadra-order-table td{vertical-align:middle}
.cuadra-empty-items{text-align:center;padding:2.2rem!important;opacity:.75}
.cuadra-order-total{display:flex;justify-content:space-between;align-items:center;gap:1rem;border-top:1px solid rgba(212,175,103,.35);padding-top:1rem;margin-top:.8rem}
.cuadra-order-total strong{font-size:1.7rem;color:#f1d69e}
.cuadra-add-panel .form-label{color:#e1eae3}
.cuadra-add-panel .form-control,.cuadra-add-panel .form-select{background:#f8faf7;color:#172d25;border-color:#c5d3c9;min-height:44px}

# Nginx como proxy inverso. Los demás dispositivos entran por http://IP_DEL_SERVIDOR/
server {
    listen 80;
    server_name _;

    location /static/ {
        alias /RUTA/AL/PROYECTO/staticfiles/;   # resultado de: python manage.py collectstatic
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
